(copy_files ../*.*)
(alias (name runtest)
  (deps (alias runtest_config)))
; TEST FILE "simple_call_order_good.c"
(alias (name "simple_call_order_good.wtests")
  (deps (alias "simple_call_order_good.0.exec.wtests")(alias "simple_call_order_good.1.exec.wtests"))) ; to performs all sub-tests related to a file
(alias (name "simple_call_order_good.c")
  (deps (alias "simple_call_order_good.0.exec")(alias "simple_call_order_good.1.exec"))) ; to reproduce and visualize the all sub-test outputs related to a file
(rule ; TEST #0 OF TEST FILE tests/call_order/simple_call_order_good.c
  (alias "simple_call_order_good.0.exec.wtests")
  (targets "simple_call_order_good.0.err.log" "simple_call_order_good.0.res.log"  )
  (deps "simple_call_order_good.0.exec.wtests" "../oracle/simple_call_order_good.0.res.oracle" "../oracle/simple_call_order_good.0.err.oracle"  "simple_call_order_good.c"  "extern_defs.h" "simple_call_order.is" (package frama-c)  (package "frama-c-vernfr") (package "frama-c-wp") )
  (enabled_if (and true %{lib-available:frama-c-vernfr.core} %{lib-available:frama-c-wp.core}))
(action (run frama-c-wtests -brief "simple_call_order_good.0.exec.wtests" "frama-c -check -no-autoload-plugins -load-plugin=vernfr,wp    simple_call_order_good.c  -vernfr -nfr-ispec simple_call_order.is -nfr-check-calls -nfr-external-call-order -keep-unused-functions all -keep-unused-types > \"simple_call_order_good.0.res.log\" 2> \"simple_call_order_good.0.err.log\"" ))
)
(rule ; REPRODUCE TEST #0 OF TEST FILE "simple_call_order_good.c"
  (alias "simple_call_order_good.0.exec")
  (deps  "simple_call_order_good.c"  "extern_defs.h" "simple_call_order.is" (package frama-c)  (package "frama-c-vernfr") (package "frama-c-wp")  (universe))
  (enabled_if (and true %{lib-available:frama-c-vernfr.core} %{lib-available:frama-c-wp.core}))
(action (with-accepted-exit-codes 0 (system "frama-c -check -no-autoload-plugins -load-plugin=vernfr,wp    simple_call_order_good.c  -vernfr -nfr-ispec simple_call_order.is -nfr-check-calls -nfr-external-call-order -keep-unused-functions all -keep-unused-types")))
)
(rule ; SHOW TEST COMMAND #0 OF TEST FILE "simple_call_order_good.c"
  (alias "simple_call_order_good.0.exec.show")
  (deps  "simple_call_order_good.c"  "extern_defs.h" "simple_call_order.is" (package frama-c)  (package "frama-c-vernfr") (package "frama-c-wp")  (universe))
  (enabled_if (and true %{lib-available:frama-c-vernfr.core} %{lib-available:frama-c-wp.core}))
(action (system "echo 'frama-c -check -no-autoload-plugins -load-plugin=vernfr,wp    simple_call_order_good.c  -vernfr -nfr-ispec simple_call_order.is -nfr-check-calls -nfr-external-call-order -keep-unused-functions all -keep-unused-types > \"simple_call_order_good.0.res.log\" 2> \"simple_call_order_good.0.err.log\"'"))
)
(rule
  (alias "simple_call_order_good.0.exec.diff")
  (enabled_if (and true %{lib-available:frama-c-vernfr.core} %{lib-available:frama-c-wp.core}))
(action (diff "../oracle/simple_call_order_good.0.res.oracle" "simple_call_order_good.0.res.log"))
)
(rule
  (alias "simple_call_order_good.0.exec.diff")
  (enabled_if (and true %{lib-available:frama-c-vernfr.core} %{lib-available:frama-c-wp.core}))
(action (diff "../oracle/simple_call_order_good.0.err.oracle" "simple_call_order_good.0.err.log"))
)
(alias (name "simple_call_order_good.diff")
  (deps (alias "simple_call_order_good.0.exec.diff"))
  (enabled_if (and true %{lib-available:frama-c-vernfr.core} %{lib-available:frama-c-wp.core}))
)
(alias (name "runtest_config")
  (deps (alias "simple_call_order_good.diff"))
  (enabled_if (and true %{lib-available:frama-c-vernfr.core} %{lib-available:frama-c-wp.core}))
)
