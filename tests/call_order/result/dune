(alias (name "call_order_ok.wtests")
  (deps (alias "call_order_ok.0.exec.wtests")(alias "call_order_ok.1.exec.wtests"))) ; to performs all sub-tests related to a file
(alias (name "call_order_ok.c")
  (deps (alias "call_order_ok.0.exec")(alias "call_order_ok.1.exec"))) ; to reproduce and visualize the all sub-test outputs related to a file
(rule ; TEST #0 OF TEST FILE tests/call_order/call_order_ok.c
  (alias "call_order_ok.0.exec.wtests")
  (targets "call_order_ok.0.err.log" "call_order_ok.0.res.log"  )
  (deps "call_order_ok.0.exec.wtests" "../oracle/call_order_ok.0.res.oracle" "../oracle/call_order_ok.0.err.oracle"  "call_order_ok.c"  "devices.h" "call_order.is" (package frama-c)  (package "frama-c-vernfr") (package "frama-c-wp") )
  (enabled_if (and true %{lib-available:frama-c-vernfr.core} %{lib-available:frama-c-wp.core}))
(action (run frama-c-wtests -brief "call_order_ok.0.exec.wtests" "frama-c -check -no-autoload-plugins -load-plugin=vernfr,wp    call_order_ok.c  -vernfr -nfr-ispec call_order.is -nfr-check-calls -nfr-external-call-order -keep-unused-functions all -keep-unused-types > \"call_order_ok.0.res.log\" 2> \"call_order_ok.0.err.log\"" ))
)
(rule ; REPRODUCE TEST #0 OF TEST FILE "call_order_ok.c"
  (alias "call_order_ok.0.exec")
  (deps  "call_order_ok.c"  "devices.h" "call_order.is" (package frama-c)  (package "frama-c-vernfr") (package "frama-c-wp")  (universe))
  (enabled_if (and true %{lib-available:frama-c-vernfr.core} %{lib-available:frama-c-wp.core}))
(action (with-accepted-exit-codes 0 (system "frama-c -check -no-autoload-plugins -load-plugin=vernfr,wp    call_order_ok.c  -vernfr -nfr-ispec call_order.is -nfr-check-calls -nfr-external-call-order -keep-unused-functions all -keep-unused-types")))
)
(rule ; SHOW TEST COMMAND #0 OF TEST FILE "call_order_ok.c"
  (alias "call_order_ok.0.exec.show")
  (deps  "call_order_ok.c"  "devices.h" "call_order.is" (package frama-c)  (package "frama-c-vernfr") (package "frama-c-wp")  (universe))
  (enabled_if (and true %{lib-available:frama-c-vernfr.core} %{lib-available:frama-c-wp.core}))
(action (system "echo 'frama-c -check -no-autoload-plugins -load-plugin=vernfr,wp    call_order_ok.c  -vernfr -nfr-ispec call_order.is -nfr-check-calls -nfr-external-call-order -keep-unused-functions all -keep-unused-types > \"call_order_ok.0.res.log\" 2> \"call_order_ok.0.err.log\"'"))
)
(rule
  (alias "call_order_ok.0.exec.diff")
  (enabled_if (and true %{lib-available:frama-c-vernfr.core} %{lib-available:frama-c-wp.core}))
(action (diff "../oracle/call_order_ok.0.res.oracle" "call_order_ok.0.res.log"))
)
(rule
  (alias "call_order_ok.0.exec.diff")
  (enabled_if (and true %{lib-available:frama-c-vernfr.core} %{lib-available:frama-c-wp.core}))
(action (diff "../oracle/call_order_ok.0.err.oracle" "call_order_ok.0.err.log"))
)
(alias (name "call_order_ok.diff")
  (deps (alias "call_order_ok.0.exec.diff"))
  (enabled_if (and true %{lib-available:frama-c-vernfr.core} %{lib-available:frama-c-wp.core}))
)
(alias (name "runtest_config")
  (deps (alias "call_order_ok.diff"))
  (enabled_if (and true %{lib-available:frama-c-vernfr.core} %{lib-available:frama-c-wp.core}))
)
(rule ; TEST #1 OF TEST FILE tests/call_order/call_order_ok.c
