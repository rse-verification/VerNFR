(copy_files ../*.*)
(alias (name runtest)
  (deps (alias runtest_config)))
; TEST FILE "tmon.c"
(alias (name "tmon.wtests")
  (deps (alias "tmon.0.exec.wtests"))) ; to performs all sub-tests related to a file
(alias (name "tmon.c")
  (deps (alias "tmon.0.exec"))) ; to reproduce and visualize the all sub-test outputs related to a file
(rule ; TEST #0 OF TEST FILE tests/tmon/tmon.c
  (alias "tmon.0.exec.wtests")
  (targets "tmon.0.err.log" "tmon.0.res.log"  )
  (deps "tmon.0.exec.wtests" "../oracle/tmon.0.res.oracle" "../oracle/tmon.0.err.oracle"  "tmon.c"  "sensors.h" "warnings.h" "utils.h" "tmon.h" "rtdb.h" "tmon.is" (package frama-c)  (package "frama-c-vernfr") (package "frama-c-wp") )
  (enabled_if (and true %{lib-available:frama-c-vernfr.core} %{lib-available:frama-c-wp.core}))
(action (run frama-c-wtests -brief "tmon.0.exec.wtests" "frama-c -check -no-autoload-plugins -load-plugin=vernfr,wp    tmon.c  -vernfr -keep-unused-functions \"all\" -keep-unused-types -nfr-ispec tmon.is -nfr-check-calls -nfr-fun-ptrs -nfr-no-fun-defs -nfr-all-entries-defined -nfr-only-entries -nfr-static-vars -nfr-proper-init -nfr-check-ptr-literals -nfr-typedefs -wp -wp-rte > \"tmon.0.res.log\" 2> \"tmon.0.err.log\"" ))
)
(rule ; REPRODUCE TEST #0 OF TEST FILE "tmon.c"
  (alias "tmon.0.exec")
  (deps  "tmon.c"  "sensors.h" "warnings.h" "utils.h" "tmon.h" "rtdb.h" "tmon.is" (package frama-c)  (package "frama-c-vernfr") (package "frama-c-wp")  (universe))
  (enabled_if (and true %{lib-available:frama-c-vernfr.core} %{lib-available:frama-c-wp.core}))
(action (with-accepted-exit-codes 0 (system "frama-c -check -no-autoload-plugins -load-plugin=vernfr,wp    tmon.c  -vernfr -keep-unused-functions \"all\" -keep-unused-types -nfr-ispec tmon.is -nfr-check-calls -nfr-fun-ptrs -nfr-no-fun-defs -nfr-all-entries-defined -nfr-only-entries -nfr-static-vars -nfr-proper-init -nfr-check-ptr-literals -nfr-typedefs -wp -wp-rte")))
)
(rule ; SHOW TEST COMMAND #0 OF TEST FILE "tmon.c"
  (alias "tmon.0.exec.show")
  (deps  "tmon.c"  "sensors.h" "warnings.h" "utils.h" "tmon.h" "rtdb.h" "tmon.is" (package frama-c)  (package "frama-c-vernfr") (package "frama-c-wp")  (universe))
  (enabled_if (and true %{lib-available:frama-c-vernfr.core} %{lib-available:frama-c-wp.core}))
(action (system "echo 'frama-c -check -no-autoload-plugins -load-plugin=vernfr,wp    tmon.c  -vernfr -keep-unused-functions \"all\" -keep-unused-types -nfr-ispec tmon.is -nfr-check-calls -nfr-fun-ptrs -nfr-no-fun-defs -nfr-all-entries-defined -nfr-only-entries -nfr-static-vars -nfr-proper-init -nfr-check-ptr-literals -nfr-typedefs -wp -wp-rte > \"tmon.0.res.log\" 2> \"tmon.0.err.log\"'"))
)
(rule
  (alias "tmon.0.exec.diff")
  (enabled_if (and true %{lib-available:frama-c-vernfr.core} %{lib-available:frama-c-wp.core}))
(action (diff "../oracle/tmon.0.res.oracle" "tmon.0.res.log"))
)
(rule
  (alias "tmon.0.exec.diff")
  (enabled_if (and true %{lib-available:frama-c-vernfr.core} %{lib-available:frama-c-wp.core}))
(action (diff "../oracle/tmon.0.err.oracle" "tmon.0.err.log"))
)
(alias (name "tmon.diff")
  (deps (alias "tmon.0.exec.diff"))
  (enabled_if (and true %{lib-available:frama-c-vernfr.core} %{lib-available:frama-c-wp.core}))
)
(alias (name "runtest_config")
  (deps (alias "tmon.diff"))
  (enabled_if (and true %{lib-available:frama-c-vernfr.core} %{lib-available:frama-c-wp.core}))
)
; TEST FILE "utils.c"
(alias (name "utils.wtests")
  (deps (alias "utils.0.exec.wtests"))) ; to performs all sub-tests related to a file
(alias (name "utils.c")
  (deps (alias "utils.0.exec"))) ; to reproduce and visualize the all sub-test outputs related to a file
(rule ; TEST #0 OF TEST FILE tests/tmon/utils.c
  (alias "utils.0.exec.wtests")
  (targets "utils.0.err.unfiltered-log" "utils.0.res.unfiltered-log"  )
  (deps "utils.0.exec.wtests" "../oracle/utils.0.res.oracle" "../oracle/utils.0.err.oracle"  "utils.c"  "utils.h" (package frama-c)  (package "frama-c-vernfr") (package "frama-c-wp") )
  (enabled_if (and true %{lib-available:frama-c-vernfr.core} %{lib-available:frama-c-wp.core}))
(action (run frama-c-wtests -brief "utils.0.exec.wtests" "frama-c -check -no-autoload-plugins -load-plugin=vernfr,wp    utils.c -wp -wp-rte > \"utils.0.res.unfiltered-log\" 2> \"utils.0.err.unfiltered-log\""  "cat utils.0.res.unfiltered-log | sed -E 's/Alt-Ergo [0-9]+\\.[0-9]+\\.[0-9]+/Alt-Ergo/g' | sed -E 's/\\([0-9]+ms(-[0-9]+ms)*\\)//g' > \"utils.0.res.log\"" "cat utils.0.err.unfiltered-log | sed -E 's/Alt-Ergo [0-9]+\\.[0-9]+\\.[0-9]+/Alt-Ergo/g' | sed -E 's/\\([0-9]+ms(-[0-9]+ms)*\\)//g' > \"utils.0.err.log\""))
)
(rule ; FILTER RES #0 OF TEST FILE "utils.c"
  (deps "utils.0.res.unfiltered-log")
         (enabled_if (and true %{lib-available:frama-c-vernfr.core} %{lib-available:frama-c-wp.core}))
(action (with-stdout-to "utils.0.res.log" (with-accepted-exit-codes (or 0 1 2 125) (system "cat utils.0.res.unfiltered-log | sed -E 's/Alt-Ergo [0-9]+\\.[0-9]+\\.[0-9]+/Alt-Ergo/g' | sed -E 's/\\([0-9]+ms(-[0-9]+ms)*\\)//g'"))))
)
(rule ; FILTER ERR #0 OF TEST FILE "utils.c"
  (deps "utils.0.err.unfiltered-log")
         (enabled_if (and true %{lib-available:frama-c-vernfr.core} %{lib-available:frama-c-wp.core}))
(action (with-stdout-to "utils.0.err.log" (with-accepted-exit-codes (or 0 1 2 125) (system "cat utils.0.err.unfiltered-log | sed -E 's/Alt-Ergo [0-9]+\\.[0-9]+\\.[0-9]+/Alt-Ergo/g' | sed -E 's/\\([0-9]+ms(-[0-9]+ms)*\\)//g'"))))
)
(rule ; REPRODUCE TEST #0 OF TEST FILE "utils.c"
  (alias "utils.0.exec")
  (deps  "utils.c"  "utils.h" (package frama-c)  (package "frama-c-vernfr") (package "frama-c-wp")  (universe))
  (enabled_if (and true %{lib-available:frama-c-vernfr.core} %{lib-available:frama-c-wp.core}))
(action (with-accepted-exit-codes 0 (system "frama-c -check -no-autoload-plugins -load-plugin=vernfr,wp    utils.c -wp -wp-rte")))
)
(rule ; SHOW TEST COMMAND #0 OF TEST FILE "utils.c"
  (alias "utils.0.exec.show")
  (deps  "utils.c"  "utils.h" (package frama-c)  (package "frama-c-vernfr") (package "frama-c-wp")  (universe))
  (enabled_if (and true %{lib-available:frama-c-vernfr.core} %{lib-available:frama-c-wp.core}))
(action (system "echo 'frama-c -check -no-autoload-plugins -load-plugin=vernfr,wp    utils.c -wp -wp-rte > \"utils.0.res.unfiltered-log\" 2> \"utils.0.err.unfiltered-log\"'"))
)
(rule
  (alias "utils.0.exec.diff")
  (enabled_if (and true %{lib-available:frama-c-vernfr.core} %{lib-available:frama-c-wp.core}))
(action (diff "../oracle/utils.0.res.oracle" "utils.0.res.log"))
)
(rule
  (alias "utils.0.exec.diff")
  (enabled_if (and true %{lib-available:frama-c-vernfr.core} %{lib-available:frama-c-wp.core}))
(action (diff "../oracle/utils.0.err.oracle" "utils.0.err.log"))
)
(alias (name "utils.diff")
  (deps (alias "utils.0.exec.diff"))
  (enabled_if (and true %{lib-available:frama-c-vernfr.core} %{lib-available:frama-c-wp.core}))
)
(alias (name "runtest_config")
  (deps (alias "utils.diff"))
  (enabled_if (and true %{lib-available:frama-c-vernfr.core} %{lib-available:frama-c-wp.core}))
)
(alias (name disabled_runtest)
  (deps (alias disabled_runtest_config)))
(alias (name runtest)
  (deps (alias disabled_runtest)))
(alias (name runtest_config)
  (deps (alias disabled_runtest_config)))
(rule ; Warns when some test conditions are disabled
  (alias disabled_runtest_config)
  (deps (universe))
  (enabled_if (or false  (not %{lib-available:frama-c-vernfr.core}) (not %{lib-available:frama-c-wp.core})))
  (action (progn (echo "WARNING: Enabling conditions of some tests are false for @tests/tmon/runtest_config\n")
                 (echo "- \%{lib-available:frama-c-vernfr.core}: " %{lib-available:frama-c-vernfr.core} "\n")
                 (echo "- \%{lib-available:frama-c-wp.core}: " %{lib-available:frama-c-wp.core} "\n")
  ))
)

