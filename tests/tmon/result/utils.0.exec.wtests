{
  "dir": "tests/tmon/result",
  "info": "TEST #0 OF TEST FILE tests/tmon/utils.c",
  "cmd": "frama-c -check -no-autoload-plugins -load-plugin=vernfr,wp    utils.c -wp -wp-rte > \"utils.0.res.unfiltered-log\" 2> \"utils.0.err.unfiltered-log\"",
  "out": "utils.0.res.log",
  "err": "utils.0.err.log",
  "tmpout": "utils.0.res.unfiltered-log",
  "tmperr": "utils.0.err.unfiltered-log",
  "sedout": "cat utils.0.res.unfiltered-log | sed -E -e 's/\\([0-9]+ms(-[0-9]+ms)*\\)//g' -e 's/^  Alt-Ergo[^:]*:/  Alt-Ergo:/' -e 's/^  ([A-Za-z][A-Za-z -]*[A-Za-z]):[[:space:]]+/  \\1: /' -e 's/[[:space:]]+$//' -e '/^\\[wp\\] \\[Cache\\]/d' > \"utils.0.res.log\"",
  "sederr": "cat utils.0.err.unfiltered-log | sed -E -e 's/\\([0-9]+ms(-[0-9]+ms)*\\)//g' -e 's/^  Alt-Ergo[^:]*:/  Alt-Ergo:/' -e 's/^  ([A-Za-z][A-Za-z -]*[A-Za-z]):[[:space:]]+/  \\1: /' -e 's/[[:space:]]+$//' -e '/^\\[wp\\] \\[Cache\\]/d' > \"utils.0.err.log\"",
  "oracle_out": "../oracle/utils.0.res.oracle",
  "oracle_err": "../oracle/utils.0.err.oracle"
}
